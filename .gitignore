# ── Whitelist pattern: ignore everything, then allow only the Apex Harness files ──

# Ignore everything by default
*

# Allow repo metadata
!.gitignore
!README.md

# Allow the Apex Harness tool itself
!apex
!apex.cmd
!apex_harness.py

# Allow bundled skill packs
!skills/
!skills/**

# Allow project documentation
!APEX_HARNESS.md
!APEX_HARNESS_HANDOFF.md
!API.md
!SETUP.md
!handoff.md

# ── Never track under any circumstance (explicit, even if whitelist changes) ──
cookies.json
cookies_*.json
cookies_*.json.bak
*.log
__pycache__/
node_modules/
.env
